# 실제 값은 .env에만 넣고 Git에는 .env.example만 올립니다.

# 향후 실제 LLM 연동 시 사용
OPENAI_API_KEY=sk-example-api-key
OPENAI_MODEL=example-model

# 1순위: Slack / Teams 등 Incoming Webhook
ALERT_WEBHOOK_URL=https://hooks.example.com/services/EXAMPLE/WEBHOOK/URL

# 2순위: 이메일 알림
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=monitor@example.com
SMTP_PASSWORD=example_password
ALERT_EMAIL_FROM=monitor@example.com
ALERT_EMAIL_TO=system-admin@example.com
